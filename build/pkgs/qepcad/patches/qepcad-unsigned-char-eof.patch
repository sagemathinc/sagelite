Description: Preserve EOF when reading QEPCAD configuration streams.
 On platforms where plain char is unsigned, storing istream::get() in a char
 turns EOF into 255.  The single-line stream parser then appends that byte
 forever instead of terminating, eventually throwing std::bad_alloc.
Origin: upstream, https://github.com/chriswestbrown/qepcad
Forwarded: no
Last-Update: 2026-07-14

--- a/source/convenientstreams.h
+++ b/source/convenientstreams.h
@@ -26,7 +26,7 @@
   slwcistream(istream& in, option opt = none)
   {
     string s = "";
-    char c = in.get(); 
+    int c = in.get();
     if (opt == skipleadingws) 
       while(c != EOF && (isspace(c) || c == '\\' && isspace(in.peek()))) c = in.get();
     // States  : 0 = normal, 1 = in comment, 2 = just read a backslash
@@ -39,7 +39,7 @@
       if (state == 1) continue;
       if (state == 0 && c == '#') { state = 1; continue; }
       if (state == 0 && c == '\\') { state = 2; continue; }
-      s += c;
+      s += static_cast<char>(c);
       state = 0;
     }while(c = in.get());
     str(s);
--- a/source/db/convenientstreams.h
+++ b/source/db/convenientstreams.h
@@ -28,7 +28,7 @@
   slwcistream(istream& in, option opt = none)
   {
     string s = "";
-    char c = in.get(); 
+    int c = in.get();
     if (opt == skipleadingws) 
       while(c != EOF && (isspace(c) || (c == '\\' && isspace(in.peek())))) c = in.get();
     // States  : 0 = normal, 1 = in comment, 2 = just read a backslash
@@ -41,7 +41,7 @@
       if (state == 1) continue;
       if (state == 0 && c == '#') { state = 1; continue; }
       if (state == 0 && c == '\\') { state = 2; continue; }
-      s += c;
+      s += static_cast<char>(c);
       state = 0;
     }while((c = in.get()));
     str(s);
