Description: Preserve and handle EOF in QEPCAD input streams.
 On platforms where plain char is unsigned, storing istream::get() in a char
 turns EOF into 255.  Preserve the integer sentinel and compare against it
 explicitly so the single-line stream parser terminates at end of input.
 Also terminate when standard input reaches EOF at the initial prompt;
 otherwise SACLIB's line discard routine waits forever for a newline.  Exit
 directly because the legacy teardown is not safe from this partial-input path.
 For noninteractive standard input, preserve EOF instead of switching to a
 controlling terminal.  Also avoid recursive reads through an invalid
 `/dev/tty` file descriptor.
Origin: upstream, https://github.com/chriswestbrown/qepcad
Forwarded: no
Last-Update: 2026-07-14

--- a/source/convenientstreams.h
+++ b/source/convenientstreams.h
@@ -26,7 +26,7 @@
   slwcistream(istream& in, option opt = none)
   {
     string s = "";
-    char c = in.get(); 
+    int c = in.get();
     if (opt == skipleadingws) 
       while(c != EOF && (isspace(c) || c == '\\' && isspace(in.peek()))) c = in.get();
     // States  : 0 = normal, 1 = in comment, 2 = just read a backslash
@@ -39,9 +39,9 @@
       if (state == 1) continue;
       if (state == 0 && c == '#') { state = 1; continue; }
       if (state == 0 && c == '\\') { state = 2; continue; }
-      s += c;
+      s += static_cast<char>(c);
       state = 0;
-    }while(c = in.get());
+    }while((c = in.get()) != EOF);
     str(s);
   }
 };
