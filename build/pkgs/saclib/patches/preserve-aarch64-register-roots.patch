Description: Preserve arm64 register-held roots during garbage collection.
 SACLIB's GC entry point tries to make the compiler spill registers by passing
 sixteen dummy register variables to an unprototyped function.  On arm64,
 live Word values can remain in the x19-x28 callee-saved registers and be
 reclaimed by the stack-scanning collector.  Explicitly save those registers
 in the scanned stack interval before collecting.
Forwarded: no
Last-Update: 2026-07-16

--- a/sysdep/linuxX86_64/GC.c
+++ b/sysdep/linuxX86_64/GC.c
@@ -16,4 +16,25 @@
 void GC(void)
 {
-
+#if defined(__aarch64__) || defined(__arm64__)
+     unsigned long registers[11];
+
+     /* A caller must already spill values held in caller-saved registers
+        before invoking GC.  Preserve the integer callee-saved registers,
+        which may legally hold live SACLIB Word values across that call. */
+     __asm__ volatile (
+          "stp x19, x20, [%0, #0]\n\t"
+          "stp x21, x22, [%0, #16]\n\t"
+          "stp x23, x24, [%0, #32]\n\t"
+          "stp x25, x26, [%0, #48]\n\t"
+          "stp x27, x28, [%0, #64]\n\t"
+          :
+          : "r" (&registers[1])
+          : "memory");
+
+     /* The collector excludes its endpoint.  Keep one boundary element
+        below the saved registers so x19 is inside the scanned interval.
+        The function prologue's saved x29 is in that interval as well. */
+     GCSI(sizeof(Word), (char *)&registers[0]);
+#else
+
      Word top_of_stack;
@@ -23,4 +44,4 @@
      r1 = gc_dummy(r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r12,r13,r14,r15,r16);
-
      GCSI(sizeof(Word),(char *)&top_of_stack);
+#endif
 }

