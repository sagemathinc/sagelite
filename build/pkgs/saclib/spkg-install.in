cd src

# CIBW sets CC to values such as "ccache cc"; pass that through to make as
# one variable assignment instead of splitting off an accidental make target.
sed -i.bak 's/make  CC=$CC/make  CC="$CC"/g' bin/mklib

saclib=$(pwd -P)
export saclib
case "$(uname -s):$(uname -m)" in
   Linux:aarch64|Linux:arm64)
      # SACLIB 2.2.8 has no Linux ARM64 sysdep profile.  The Linux 64-bit
      # profile only supplies endian/word-size macros and generic fenv support.
      (cd sysdep/linuxX86_64 && ./install)
      ;;
   *)
      bin/sconf
      ;;
esac
bin/mkproto && bin/mkmake && bin/mklib all
if [ $? -ne 0 ] || [ ! -s lib/saclibo.a ] || [ ! -s lib/saclibd.a ]; then
   echo >&2 "Error building saclib."
   exit 1
fi


# install saclib to the Sage tree
cd ..
rm -rf $SAGE_LOCAL/lib/saclib
mv src $SAGE_LOCAL/lib/saclib
